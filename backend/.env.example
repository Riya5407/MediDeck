# Environment variables for MediDeck backend
# PostgreSQL connection string
# Local development:
# DATABASE_URL=postgresql://postgres:admin@localhost:5432/Pharmacy_Management
# Production (Neon PostgreSQL with SSL):
# DATABASE_URL=postgresql://[user]:[password]@[neon-host]/pharmacy_management?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/Pharmacy_Management

# Business constants
LOW_STOCK_THRESHOLD=20
EXPIRY_WARNING_DAYS=30
PAYMENT_MODES=Cash,Card,UPI

# CORS origins (comma-separated list, e.g. http://localhost:5173,https://medi-deck.vercel.app)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,https://medi-deck.vercel.app

# Authentication & Security
# Set ENVIRONMENT=production on Render to enforce custom secrets and hashes
ENVIRONMENT=development
AUTH_ENABLED=true
JWT_SECRET=your-secure-random-jwt-secret-minimum-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
COOKIE_SECURE=false # Set to true in production with HTTPS

# Predefined Accounts (Generate hashes using: python scripts/hash_password.py)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$6tr/dm1Ktsw0wI81pvKOig$dfNBHjfWmjZ7zgT72QAS9N+NQuZnPj5HSEXX8uV9lwU

PHARMACIST_USERNAME=pharmacist
PHARMACIST_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$30L03Zr8nEq06P4elF5yRw$CHK1v2PS61MsbX0Wl/pgIKed/kqFSFpiZ4M7/X5iMTQ

CASHIER_USERNAME=cashier
CASHIER_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$muAGHi4jVdyWE/ipf6i8iw$XDE4jLyvrcuKltCTgg+MEfmyJAUD6NAjB2S+WHWDpWk
