# Environment variables for MediDesk backend
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/Pharmacy_Management

# Business constants
LOW_STOCK_THRESHOLD=20
EXPIRY_WARNING_DAYS=30
PAYMENT_MODES=Cash,Card,UPI

# CORS origins (comma-separated list, e.g. http://localhost:5173,https://your-domain.com)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
