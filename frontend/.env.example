# Frontend API base URL
# Leave blank (empty) for both local development (Vite proxy) and Vercel deployment (vercel.json proxy).
# When using the Vercel same-origin proxy rewrite in vercel.json, leaving VITE_API_URL empty ensures
# all requests use relative /api paths and cookies are treated as first-party SameSite=Lax.
VITE_API_URL=
